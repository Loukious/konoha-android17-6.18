Subject: [PATCH] Add opt-in QDSS and AMBA startup clock diagnostics

Log consumer identities, clock reference snapshots and AMBA callback phases
without changing clock calls, warning checks or return values.

---
diff --git a/drivers/amba/bus.c b/drivers/amba/bus.c
--- a/drivers/amba/bus.c
+++ b/drivers/amba/bus.c
@@ -60,6 +60,22 @@
 	return NULL;
 }
 
+/* Enable only in a controlled startup clock diagnostic. */
+static bool konoha_amba_pm_trace;
+core_param(konoha_amba_pm_trace, konoha_amba_pm_trace, bool, 0644);
+
+static void amba_clock_trace(struct device *dev, const char *stage, int ret)
+{
+	struct amba_device *pcdev = to_amba_device(dev);
+
+	if (konoha_amba_pm_trace)
+		dev_info(dev, "Konoha AMBA clock:%s ret=%d clk=%p usage=%d depth=%u status=%u\n",
+			 stage, ret, pcdev->pclk,
+			 atomic_read(&dev->power.usage_count),
+			 (unsigned int)dev->power.disable_depth,
+			 READ_ONCE(dev->power.runtime_status));
+}
+
 static int amba_get_enable_pclk(struct amba_device *pcdev)
 {
 	int ret;
@@ -68,7 +84,9 @@
 	if (IS_ERR(pcdev->pclk))
 		return PTR_ERR(pcdev->pclk);
 
+	amba_clock_trace(&pcdev->dev, "acquire.enter", 0);
 	ret = clk_prepare_enable(pcdev->pclk);
+	amba_clock_trace(&pcdev->dev, "acquire.exit", ret);
 	if (ret)
 		clk_put(pcdev->pclk);
 
@@ -77,7 +95,9 @@
 
 static void amba_put_disable_pclk(struct amba_device *pcdev)
 {
+	amba_clock_trace(&pcdev->dev, "put.enter", 0);
 	clk_disable_unprepare(pcdev->pclk);
+	amba_clock_trace(&pcdev->dev, "put.exit", 0);
 	clk_put(pcdev->pclk);
 }
 
@@ -391,15 +411,21 @@
 static int amba_pm_runtime_suspend(struct device *dev)
 {
 	struct amba_device *pcdev = to_amba_device(dev);
-	int ret = pm_generic_runtime_suspend(dev);
+	int ret;
+
+	amba_clock_trace(dev, "suspend.enter", 0);
+	ret = pm_generic_runtime_suspend(dev);
+	amba_clock_trace(dev, "suspend.driver-exit", ret);
 
 	if (ret == 0 && dev->driver) {
+		amba_clock_trace(dev, "suspend.bus-release", 0);
 		if (pm_runtime_is_irq_safe(dev))
 			clk_disable(pcdev->pclk);
 		else
 			clk_disable_unprepare(pcdev->pclk);
 	}
 
+	amba_clock_trace(dev, "suspend.exit", ret);
 	return ret;
 }
 
@@ -408,17 +434,21 @@
 	struct amba_device *pcdev = to_amba_device(dev);
 	int ret;
 
+	amba_clock_trace(dev, "resume.enter", 0);
 	if (dev->driver) {
 		if (pm_runtime_is_irq_safe(dev))
 			ret = clk_enable(pcdev->pclk);
 		else
 			ret = clk_prepare_enable(pcdev->pclk);
+		amba_clock_trace(dev, "resume.bus-acquire", ret);
 		/* Failure is probably fatal to the system, but... */
 		if (ret)
 			return ret;
 	}
 
-	return pm_generic_runtime_resume(dev);
+	ret = pm_generic_runtime_resume(dev);
+	amba_clock_trace(dev, "resume.driver-exit", ret);
+	return ret;
 }
 #endif /* CONFIG_PM */
 
diff --git a/drivers/clk/clk.c b/drivers/clk/clk.c
--- a/drivers/clk/clk.c
+++ b/drivers/clk/clk.c
@@ -119,6 +119,27 @@
 	struct hlist_node clks_node;
 };
 
+/* Opt-in startup evidence; clock reference handling is unchanged. */
+static bool konoha_qdss_trace;
+core_param(konoha_qdss_trace, konoha_qdss_trace, bool, 0644);
+
+static void clk_qdss_trace_core(struct clk_core *core, const char *stage)
+{
+	if (konoha_qdss_trace && core && !strcmp(core->name, "qdss"))
+		pr_info("Konoha QDSS core:%s enable=%u prepare=%u core=%p\n",
+			stage, READ_ONCE(core->enable_count),
+			READ_ONCE(core->prepare_count), core);
+}
+
+static void clk_qdss_trace_consumer(struct clk *clk, const char *stage,
+				    unsigned long caller)
+{
+	if (konoha_qdss_trace && !IS_ERR_OR_NULL(clk) &&
+	    !strcmp(clk->core->name, "qdss"))
+		pr_info("Konoha QDSS consumer:%s dev=%s con=%s clk=%p caller=%pS\n",
+			stage, clk->dev_id, clk->con_id, clk, (void *)caller);
+}
+
 /***           runtime pm          ***/
 static int clk_pm_runtime_get(struct clk_core *core)
 {
@@ -1046,6 +1067,8 @@
 	if (!core)
 		return;
 
+	clk_qdss_trace_core(core, "unprepare.enter");
+
 	if (WARN(core->prepare_count == 0,
 	    "%s already unprepared\n", core->name))
 		return;
@@ -1095,6 +1118,8 @@
 	if (IS_ERR_OR_NULL(clk))
 		return;
 
+	clk_qdss_trace_consumer(clk, __func__, _RET_IP_);
+
 	clk_core_unprepare_lock(clk->core);
 }
 EXPORT_SYMBOL_GPL(clk_unprepare);
@@ -1107,6 +1132,8 @@
 
 	if (!core)
 		return 0;
+
+	clk_qdss_trace_core(core, "prepare.enter");
 
 	if (core->prepare_count == 0) {
 		ret = clk_pm_runtime_get(core);
@@ -1129,6 +1156,7 @@
 	}
 
 	core->prepare_count++;
+	clk_qdss_trace_core(core, "prepare.acquired");
 
 	/*
 	 * CLK_SET_RATE_GATE is a special case of clock protection
@@ -1176,6 +1204,8 @@
 	if (!clk)
 		return 0;
 
+	clk_qdss_trace_consumer(clk, __func__, _RET_IP_);
+
 	return clk_core_prepare_lock(clk->core);
 }
 EXPORT_SYMBOL_GPL(clk_prepare);
@@ -1186,6 +1216,8 @@
 
 	if (!core)
 		return;
+
+	clk_qdss_trace_core(core, "disable.enter");
 
 	if (WARN(core->enable_count == 0, "%s already disabled\n", core->name))
 		return;
@@ -1233,6 +1265,8 @@
 	if (IS_ERR_OR_NULL(clk))
 		return;
 
+	clk_qdss_trace_consumer(clk, __func__, _RET_IP_);
+
 	clk_core_disable_lock(clk->core);
 }
 EXPORT_SYMBOL_GPL(clk_disable);
@@ -1245,6 +1279,8 @@
 
 	if (!core)
 		return 0;
+
+	clk_qdss_trace_core(core, "enable.enter");
 
 	if (WARN(core->prepare_count == 0,
 	    "Enabling unprepared %s\n", core->name))
@@ -1270,6 +1306,7 @@
 	}
 
 	core->enable_count++;
+	clk_qdss_trace_core(core, "enable.acquired");
 	return 0;
 }
 
@@ -1397,6 +1434,8 @@
 {
 	if (!clk)
 		return 0;
+
+	clk_qdss_trace_consumer(clk, __func__, _RET_IP_);
 
 	return clk_core_enable_lock(clk->core);
 }
