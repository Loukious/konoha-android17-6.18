 static void qmp_shutdown(struct mbox_chan *chan)
 {
 	struct qmp_mbox *mbox = chan->con_priv;
+	unsigned long flags;
 
 	mutex_lock(&mbox->state_lock);
+	if (mbox->ctrl.num_chans == 1) {
+		/* RX runs under this mutex. Stop it before mailbox core clears cl. */
+		mbox->rx_disabled = true;
+		spin_lock_irqsave(&mbox->tx_lock, flags);
+		mbox->stopping = true;
+		mbox->tx_sent = false;
+		spin_unlock_irqrestore(&mbox->tx_lock, flags);
+		if (mbox->local_state > LINK_CONNECTED &&
+		    mbox->local_state != LOCAL_DISCONNECTING) {
+			mbox->local_state = LOCAL_DISCONNECTING;
+			set_mcore_ch(mbox, QMP_MBOX_CH_DISCONNECTED);
+			send_irq(mbox->mdev);
+		}
+		mbox->num_shutdown = 0;
+		mbox->num_assigned = 0;
+		mutex_unlock(&mbox->state_lock);
+		/* The timeout callback may still be notifying core/client; drain it. */
+		cancel_delayed_work_sync(&mbox->dwork);
+		return;
+	}
 	if (mbox->local_state <= LINK_CONNECTED) {
 		mbox->num_assigned--;
 		goto out;
