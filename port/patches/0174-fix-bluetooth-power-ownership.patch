Subject: [PATCH] Keep Bluetooth power ownership consistent across control paths

Route rfkill through the shared state machine so platform/core votes and
SSR handling agree with vendor ioctls. Release the chip clock only when
this driver acquired it. Acquire QMP only for declared AOP resources,
and propagate failures for boards that require that backend.

---
diff --git a/qcom/opensource/bt-kernel/pwr/btpower.c b/qcom/opensource/bt-kernel/pwr/btpower.c
--- a/qcom/opensource/bt-kernel/pwr/btpower.c
+++ b/qcom/opensource/bt-kernel/pwr/btpower.c
@@ -410,7 +410,6 @@
 };
 
 static struct platform_pwr_data *pwr_data;
-static bool previous;
 static struct class *bt_class;
 static int bt_major;
 static int soc_id;
@@ -437,6 +436,8 @@
 static struct fmdOperationStruct fmdStruct;
 char *default_crash_reason = "Crash reason not found";
 
+static int btpower_on(enum plt_pwr_state client);
+static int btpower_off(enum plt_pwr_state client);
 static int btpower_enable_ipa_vreg(struct platform_pwr_data *pdata);
 static inline int btpower_get_retenion_mode_state(void);
 static void bt_power_vote(struct work_struct *work);
@@ -1121,7 +1122,7 @@
 gpio_fail:
 		if (!get_fmd_mode()) {
 			bt_release_gpios();
-			if (pwr_data->bt_chip_clk)
+			if (pwr_data->bt_chip_clk && pwr_data->bt_chip_clk->is_enabled)
 				bt_clk_disable(pwr_data->bt_chip_clk);
 		}
 regulator_fail:
@@ -1372,12 +1373,10 @@
 	if (!pdata || !pdata->power_setup)
 		return -ENODEV;
 	mutex_lock(&btpower_operation_lock);
-	if (previous != blocked)
-		ret = pdata->power_setup(BT_CORE, !blocked);
-	if (!ret)
-		previous = blocked;
+	/* Share platform votes, retention and SSR state with queued ioctls. */
+	ret = blocked ? btpower_off(POWER_OFF_BT) : btpower_on(POWER_ON_BT);
 	mutex_unlock(&btpower_operation_lock);
-	return ret;
+	return ret < 0 ? ret : 0;
 }
 
 static const struct rfkill_ops btpower_rfkill_ops = {
@@ -1415,7 +1414,6 @@
 
 	/* force Bluetooth off during init to allow for user control */
 	rfkill_init_sw_state(rfkill, 1);
-	previous = true;
 
 	ret = rfkill_register(rfkill);
 	if (ret) {
@@ -1980,7 +1978,7 @@
 
 	bt_power_pdc_init_params(pwr_data);
 	ret = btpower_aop_mbox_init(pwr_data);
-	if (ret == -EPROBE_DEFER)
+	if (ret < 0)
 		goto free_pdata;
 
 	ret = btpower_rfkill_probe(pdev);
@@ -3299,24 +3297,33 @@
 
 int btpower_aop_mbox_init(struct platform_pwr_data *pdata)
 {
-	int ret = 0;
-// ret = of_find_property(pdata->pdev->dev.of_node, "qcom,qmp", NULL);
-	pdata->qmp = qmp_get(&pdata->pdev->dev);
-	if (IS_ERR(pdata->qmp)) {
-		pr_err("%s: failed to get qmp\n", __func__);
-		return PTR_ERR(pdata->qmp);
-	}
-	ret = of_property_read_string(pdata->pdev->dev.of_node,
-				      "qcom,vreg_ipa",
-				      &pdata->vreg_ipa);
-	if (ret)
-		pr_info("%s: vreg for iPA not configured\n", __func__);
-	else
-		pr_info("%s: qmp initialized\n", __func__);
+	struct device *dev = &pdata->pdev->dev;
+	int ret;
+
+	/* Direct-regulator boards need no AOP mailbox. */
+	if (!of_property_present(dev->of_node, "qcom,qmp")) {
+		if (of_property_present(dev->of_node, "qcom,pdc_init_table") ||
+		    of_property_present(dev->of_node, "qcom,vreg_ipa"))
+			return dev_err_probe(dev, -EINVAL,
+					     "AOP resources require qcom,qmp\n");
+		return 0;
+	}
+
+	pdata->qmp = qmp_get(dev);
+	if (IS_ERR(pdata->qmp))
+		return dev_err_probe(dev, PTR_ERR(pdata->qmp),
+				     "failed to get qmp\n");
+
+	if (of_property_present(dev->of_node, "qcom,vreg_ipa")) {
+		ret = of_property_read_string(dev->of_node, "qcom,vreg_ipa",
+					      &pdata->vreg_ipa);
+		if (ret)
+			return dev_err_probe(dev, ret, "invalid qcom,vreg_ipa\n");
+	}
 
 	ret = bt_aop_pdc_reconfig(pdata);
 	if (ret)
-		pr_err("Failed to reconfig BT WLAN PDC, err = %d\n", ret);
+		return dev_err_probe(dev, ret, "failed to configure BT WLAN PDC\n");
 
 	return 0;
 }
