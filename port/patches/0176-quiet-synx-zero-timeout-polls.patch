Subject: [PATCH] Keep SYNX status polls out of timeout error logs

---
diff --git a/qcom/opensource/synx-kernel/msm/synx/synx.c b/qcom/opensource/synx-kernel/msm/synx/synx.c
--- a/qcom/opensource/synx-kernel/msm/synx/synx.c
+++ b/qcom/opensource/synx-kernel/msm/synx/synx.c
@@ -1453,9 +1453,11 @@
 	timeleft = dma_fence_wait_timeout(synx_obj->fence, (bool) 0,
 					msecs_to_jiffies(timeout_ms));
 	if (timeleft <= 0) {
-		dprintk(SYNX_ERR,
-			"[sess :%llu] wait timeout for handle %u\n",
-			client->id, h_synx);
+		/* An unsignaled zero-timeout poll is expected, not a stalled wait. */
+		if (timeout_ms)
+			dprintk(SYNX_ERR,
+				"[sess :%llu] wait timeout for handle %u\n",
+				client->id, h_synx);
 		rc = -ETIMEDOUT;
 		goto fail;
 	}
