+static void free_vx_data(struct vx_log *log)
+{
+	int i;
+
+	for (i = 0; i < log->loglines; i++)
+		kfree(log->data[i].drv_vx);
+	kfree(log->data);
+	log->data = NULL;
+	log->loglines = 0;
