+		drp_valid[i] = !regmap_read(drv->regmaps[i], drv->edac_reg_offset->drp_interrupt_status, &drp[i]);
+		trp_valid[i] = !regmap_read(drv->regmaps[i], drv->edac_reg_offset->trp_interrupt_0_status, &trp[i]);
+	}
+	/* Uncorrectable errors take precedence across all banks. */
+	for (bit = DB_ECC_ERROR; bit; bit >>= 1) {
