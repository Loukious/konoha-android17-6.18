+static void qcom_llcc_edac_remove(struct platform_device *pdev)
+{
+	struct edac_device_ctl_info *ctl = platform_get_drvdata(pdev);
+	struct qcom_llcc_edac *st = ctl->pvt_info;
+
+	mutex_lock(&st->lock);
+	st->active = false;
+	qcom_llcc_restore_setup(st);
+	mutex_unlock(&st->lock);
+	/* Both IRQ and EDAC polling callbacks must finish before ctl is freed. */
+	if (st->irq_requested)
+		devm_free_irq(&pdev->dev, st->drv->ecc_irq, ctl);
+	edac_device_del_device(ctl->dev);
+	platform_set_drvdata(pdev, NULL);
+	edac_device_free_ctl_info(ctl);
 }
 
