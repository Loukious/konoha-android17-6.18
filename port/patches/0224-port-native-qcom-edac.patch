+struct qcom_llcc_edac {
+	struct edac_device_ctl_info *ctl;
+	struct llcc_drv_data *drv;
+	struct mutex lock;
+	bool active;
+	bool configured;
+	bool irq_requested;
+	bool registered;
+	u32 saved[4];
+};
+
+static void qcom_llcc_setup_registers(struct llcc_drv_data *drv, u32 *regs)
+{
+	regs[0] = drv->edac_reg_offset->cmn_interrupt_0_enable;
+	regs[1] = drv->edac_reg_offset->trp_interrupt_0_enable;
+	regs[2] = drv->edac_reg_offset->drp_ecc_error_cfg;
+	regs[3] = drv->edac_reg_offset->drp_interrupt_enable;
+}
+
+static const u32 qcom_llcc_setup_masks[] = {
+	TRP0_INTERRUPT_ENABLE | DRP0_INTERRUPT_ENABLE,
+	SB_DB_TRP_INTERRUPT_ENABLE, U32_MAX, U32_MAX,
+};
+
+static void qcom_llcc_restore_setup(struct qcom_llcc_edac *st)
+{
+	u32 regs[4];
+	int i, ret;
+
+	if (!st->configured)
+		return;
+	qcom_llcc_setup_registers(st->drv, regs);
+	for (i = ARRAY_SIZE(regs) - 1; i >= 0; i--) {
+		ret = regmap_update_bits(st->drv->bcast_regmap, regs[i],
+					 qcom_llcc_setup_masks[i], st->saved[i]);
+		if (ret)
+			dev_err(st->ctl->dev, "Failed to restore ECC register %#x: %d\n",
+				regs[i], ret);
+	}
+	st->configured = false;
+}
+
+static int qcom_llcc_core_setup(struct qcom_llcc_edac *st)
+{
+	u32 regs[4];
+	const u32 values[] = {
+		TRP0_INTERRUPT_ENABLE | DRP0_INTERRUPT_ENABLE,
+		SB_DB_TRP_INTERRUPT_ENABLE,
+		SB_ERROR_THRESHOLD << SB_ERROR_THRESHOLD_SHIFT,
+		SB_DB_DRP_INTERRUPT_ENABLE,
+	};
+	int i, ret;
+
+	qcom_llcc_setup_registers(st->drv, regs);
+	/* Snapshot before any write. Publish handlers only after all writes pass. */
+	for (i = 0; i < ARRAY_SIZE(regs); i++) {
+		ret = regmap_read(st->drv->bcast_regmap, regs[i], &st->saved[i]);
+		if (ret)
+			return ret;
+	}
+	st->configured = true;
+	for (i = 0; i < ARRAY_SIZE(regs); i++) {
+		ret = regmap_update_bits(st->drv->bcast_regmap, regs[i],
+					 qcom_llcc_setup_masks[i], values[i]);
+		if (ret)
+			return ret;
+	}
+	return 0;
 }
 
