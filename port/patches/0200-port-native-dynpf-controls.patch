+static void dynpf_kobject_cleanup(void *arg)
+{
+	mutex_lock(&dynpf_lock);
+	dynpf_ready = false;
+	mutex_unlock(&dynpf_lock);
+	kobject_del(&dynpf_kobj);
+	kobject_put(&dynpf_kobj);
+	wait_for_completion(&dynpf_released);
