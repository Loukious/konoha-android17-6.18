Subject: [PATCH] Accept shared WLAN configuration commands without power attributes quietly

---
diff --git a/qcacld-3.0/core/hdd/src/wlan_hdd_cfg80211.c b/qcacld-3.0/core/hdd/src/wlan_hdd_cfg80211.c
--- a/qcacld-3.0/core/hdd/src/wlan_hdd_cfg80211.c
+++ b/qcacld-3.0/core/hdd/src/wlan_hdd_cfg80211.c
@@ -11048,11 +11048,9 @@
 
 	hdd_enter_dev(adapter->dev);
 
-	if (!power_attr && !opm_attr) {
-		hdd_err_rl("power attr and opm attr is null");
+	/* Other shared configuration commands need not carry power attributes. */
+	if (!power_attr && !opm_attr)
 		return 0;
-	}
-
 
 	if (power_attr && opm_attr) {
 		hdd_err_rl("Invalid OPM set attribute");
