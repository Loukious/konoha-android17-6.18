 		return dev_err_probe(&t_info->pdev->dev, ret, "Cannot read cluster config at %pa\n", &addr);
 
@@ -718,7 +751,8 @@ static int qcom_cpuss_read_lpm_and_residency_cfg_informaion(struct qcom_target_i
 
