+/* Parse one complete gear assignment without modifying configfs input. */
+static inline int qcom_mpam_parse_gear(const char *buf, size_t count, u32 *gear)
+{
+	char *copy, *cursor, *token, *name;
+	bool found = false;
+	int ret = -EINVAL;
+
+	if (!count || count >= PAGE_SIZE || memchr(buf, '\0', count))
+		return -EINVAL;
+	copy = kmemdup_nul(buf, count, GFP_KERNEL);
+	if (!copy)
+		return -ENOMEM;
+	cursor = copy;
+	while ((token = strsep(&cursor, ","))) {
+		name = strsep(&token, "=");
+		if (!token || strcmp(name, "gear") || found)
+			goto out;
+		if (kstrtou32(token, 0, gear))
+			goto out;
+		found = true;
+	}
+	if (found)
+		ret = 0;
+out:
+	kfree(copy);
+	return ret;
+}
+
