+
+	if (!size || size % IOMMU_DEBUG_DMA_GRANULE ||
+	    size / IOMMU_DEBUG_DMA_GRANULE >= IOMMU_DEBUG_DMA_CONT)
+		return -EINVAL;
+	addr = dma_map_single(ledger->dev, virt, size, DMA_TO_DEVICE);
+	if (dma_mapping_error(ledger->dev, addr))
