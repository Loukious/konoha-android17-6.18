+
+	buffer = kstrdup(input, GFP_KERNEL);
+	if (!buffer)
+		return -ENOMEM;
+	first = strim(buffer);
+	second = strpbrk(first, " \t");
+	if (!second) {
+		ret = -EINVAL;
+		goto out;
+	}
+	*second++ = '\0';
+	second = strim(second);
+	ret = kstrtou32(first, 10, &values[0]);
+	if (ret)
+		goto out;
+	ret = kstrtou32(second, 10, &values[1]);
+out:
+	kfree(buffer);
+	return ret;
+}
