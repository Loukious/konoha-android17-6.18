+#define store_c1dcvs_thresh(name) \
+static ssize_t store_##name(struct kobject *kobj, struct attribute *attr, \
+			   const char *buf, size_t count) \
+{ \
+	u32 values[2] = { }; \
+	int ret = c1dcvs_parse_threshold(buf, values); \
+	if (ret) \
+		return ret; \
+	values[0] = cpu_to_le32(values[0]); \
+	values[1] = cpu_to_le32(values[1]); \
+	ret = set_##name(values, sizeof(values)); \
+	return ret < 0 ? ret : count; \
