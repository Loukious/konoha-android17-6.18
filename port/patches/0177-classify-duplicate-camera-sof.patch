Subject: [PATCH] Classify request-less repeated SOF timestamps as debug

---
diff --git a/qcom/opensource/camera-kernel/drivers/cam_isp/cam_isp_context.c b/qcom/opensource/camera-kernel/drivers/cam_isp/cam_isp_context.c
--- a/qcom/opensource/camera-kernel/drivers/cam_isp/cam_isp_context.c
+++ b/qcom/opensource/camera-kernel/drivers/cam_isp/cam_isp_context.c
@@ -1609,6 +1609,14 @@
 			"ctx:%u link:0x%x recover time(last:0x%llx,prev:0x%llx,curr:0x%llx)req:%llu",
 			ctx->ctx_id, ctx->link_hdl, a, b, c, request_id);
 	} else {
+		/* A request-less notification may repeat the SOF already handled. */
+		if (!request_id && a == curr_ts) {
+			CAM_DBG(CAM_ISP,
+				"ctx:%u link:0x%x duplicate SOF timestamp:0x%llx",
+				ctx->ctx_id, ctx->link_hdl, a);
+			return 0;
+		}
+
 		/* Hardware is at frame A (which we supposedly missed) */
 		CAM_ERR_RATE_LIMIT(CAM_ISP,
 			"ctx:%u link: 0x%x erroneous call to SOF recovery(last:0x%llx, prev:0x%llx, curr:0x%llx) req: %llu",
