+static bool pmic_glink_filter_reply(struct pmic_glink_dev *pgdev,
+				   const void *data, size_t len)
+{
+	struct pmic_glink_hdr hdr;
+	struct pmic_glink_reply_fence *fence, *tmp;
+	bool valid;
