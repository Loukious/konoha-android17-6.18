+	    d->max_conditions <= 0 || d->max_conditions > 4 ||
+	    d->max_regs <= 0 || d->max_regs > 24 ||
+	    d->max_timer_counter <= 0 || d->max_timer_counter > MAX_TIMER_COUNTER_SETS)
+		return -EINVAL;
