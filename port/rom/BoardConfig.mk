# Build the synced Onyx 6.18 port through Lineage's Kleaf kernel path.
# The adapter resolves KernelSU Next dev and fetches pinned Kleaf dependencies
# before compilation; Android's Ninja sandbox otherwise has no network access.
BUILD_BROKEN_USES_NETWORK := true
KONOHA_KERNEL_SOURCE := kernel/platform/kernel-6.18
ifeq ($(wildcard $(KONOHA_KERNEL_SOURCE)/port/build.py),)
$(error Onyx kernel source missing; sync the source-build local manifest)
endif
TARGET_KERNEL_SOURCE := common
TARGET_KERNEL_VERSION := 6.18
TARGET_KERNEL_PLATFORM_TARGET := onyx
TARGET_KERNEL_PORT_BUILD := $(KONOHA_KERNEL_SOURCE)/port/rom/build.py
TARGET_KERNEL_PORT_HEADERS := $(KONOHA_KERNEL_SOURCE)/port/rom/headers.py
TARGET_KERNEL_PORT_JOBS ?= 12
TARGET_KERNEL_PORT_MEMORY_MB ?= 20000
TARGET_KERNEL_CONFIG :=
TARGET_KERNEL_CONFIG_EXT :=
TARGET_KERNEL_EXT_MODULE_ROOT :=
TARGET_KERNEL_EXT_MODULES :=
TARGET_FORCE_PREBUILT_KERNEL :=
TARGET_PREBUILT_KERNEL :=
TARGET_PREBUILT_KERNEL_HEADERS :=
TARGET_OVERRIDE_KERNEL_BIN :=
BOARD_USES_QCOM_MERGE_DTBS_SCRIPT := false
BOARD_PREBUILT_DTBIMAGE_DIR :=
BOARD_KERNEL_SEPARATED_DTBO := true
BOARD_PREBUILT_DTBOIMAGE = $(TARGET_OUT_INTERMEDIATES)/DTBO_OBJ/dtbo.img
BOARD_KERNEL_CMDLINE := $(filter-out android_arch_task_struct_size=% sched_proxy_exec=%,$(BOARD_KERNEL_CMDLINE)) $(strip $(shell cat $(KONOHA_KERNEL_SOURCE)/port/boot-parameters.txt))
TARGET_KERNEL_MIXED_MODE := true
# Lists and dependency closure are produced from the newly compiled modules.
# These nonempty selectors enable Lineage's ramdisk/recovery packaging targets.
BOOT_KERNEL_MODULES := onyx-source-layout
RECOVERY_KERNEL_MODULES := onyx-source-layout
SYSTEM_KERNEL_MODULES :=
BOARD_SYSTEM_DLKM_SRC :=
BOARD_SYSTEM_KERNEL_MODULES :=
BOARD_VENDOR_KERNEL_MODULES :=
BOARD_VENDOR_RAMDISK_KERNEL_MODULES :=
BOARD_RECOVERY_KERNEL_MODULES :=
BOARD_SYSTEM_KERNEL_MODULES_LOAD :=
BOARD_VENDOR_KERNEL_MODULES_LOAD :=
BOARD_VENDOR_RAMDISK_KERNEL_MODULES_LOAD :=
BOARD_VENDOR_RAMDISK_RECOVERY_KERNEL_MODULES_LOAD :=
BOARD_RECOVERY_KERNEL_MODULES_LOAD :=
BOARD_DO_NOT_STRIP_VENDOR_MODULES := true
BOARD_DO_NOT_STRIP_VENDOR_RAMDISK_MODULES := true
BOARD_DO_NOT_STRIP_RECOVERY_MODULES := true
BOARD_SYSTEM_KERNEL_MODULES_BLOCKLIST_FILE := $(wildcard $(KONOHA_KERNEL_SOURCE)/port/rom/module-config/system_dlkm/modules.blocklist)
BOARD_VENDOR_KERNEL_MODULES_BLOCKLIST_FILE := $(wildcard $(KONOHA_KERNEL_SOURCE)/port/rom/module-config/vendor_dlkm/modules.blocklist)
BOARD_VENDOR_RAMDISK_KERNEL_MODULES_BLOCKLIST_FILE := $(wildcard $(KONOHA_KERNEL_SOURCE)/port/rom/module-config/vendor_ramdisk/modules.blocklist)
BOARD_RECOVERY_KERNEL_MODULES_BLOCKLIST_FILE := $(BOARD_VENDOR_RAMDISK_KERNEL_MODULES_BLOCKLIST_FILE)
BOARD_SYSTEM_KERNEL_MODULES_OPTIONS_FILE := $(wildcard $(KONOHA_KERNEL_SOURCE)/port/rom/module-config/system_dlkm/modules.options)
BOARD_VENDOR_KERNEL_MODULES_OPTIONS_FILE := $(wildcard $(KONOHA_KERNEL_SOURCE)/port/rom/module-config/vendor_dlkm/modules.options)
BOARD_VENDOR_RAMDISK_KERNEL_MODULES_OPTIONS_FILE := $(wildcard $(KONOHA_KERNEL_SOURCE)/port/rom/module-config/vendor_ramdisk/modules.options)
BOARD_RECOVERY_KERNEL_MODULES_OPTIONS_FILE := $(BOARD_VENDOR_RAMDISK_KERNEL_MODULES_OPTIONS_FILE)
